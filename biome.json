{
    "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
    "files": {
        "includes": ["gitlab-graph.user.js", "test/**", "!tmp", "!node_modules"]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 200
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "complexity": {
                "useOptionalChain": "off"
            },
            "suspicious": {
                "noRedundantUseStrict": "off"
            }
        }
    },
    "javascript": {
        "formatter": {
            "semicolons": "always"
        }
    }
}
